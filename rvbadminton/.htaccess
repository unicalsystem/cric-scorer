# RV Badminton scorer
Options -Indexes
DirectoryIndex index.php

<FilesMatch "^(config(\.local)?(\.sample)?\.php|.*\.sql|.*\.md|.*\.log)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(inc|tools)/ - [F,L]
  RewriteRule ^m/([0-9]+)/?$ index.php?m=$1 [L,QSA]
</IfModule>
<IfModule mod_headers.c>
  <Files "sw.js">
    Header set Cache-Control "no-cache"
  </Files>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
